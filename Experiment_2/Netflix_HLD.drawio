<mxfile host="app.diagrams.net">
  <diagram id="mQuChAjISxrGtDkmrOxE" name="Page-1">
    <mxGraphModel dx="1288" dy="823" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="req" parent="1" style="text;html=1;strokeColor=#999999;fillColor=#f9f9f9;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;rounded=1;shadow=1;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;1: Functional / Non-Functional Requirements&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Functional:&lt;/b&gt;&lt;br&gt;• Users can search, browse, and view video metadata.&lt;br&gt;• Stream videos seamlessly across various resolutions/devices.&lt;br&gt;• System records watch history and playback state (resume).&lt;br&gt;&lt;br&gt;&lt;b&gt;Non-Functional:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;High Availability:&lt;/b&gt; Core streaming must not drop.&lt;br&gt;• &lt;b&gt;Low Latency:&lt;/b&gt; Playback starts in under 2 seconds.&lt;br&gt;• &lt;b&gt;Scalability:&lt;/b&gt; Handle sudden traffic spikes (new releases).&lt;br&gt;• &lt;b&gt;Consistency:&lt;/b&gt; Eventual consistency for watch history." vertex="1">
          <mxGeometry height="260" width="340" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="est" parent="1" style="text;html=1;strokeColor=#999999;fillColor=#f9f9f9;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;rounded=1;shadow=1;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;2: Back of the Envelope Estimation&lt;/b&gt;&lt;hr&gt;&lt;i&gt;Assumptions: 200M DAU, 2 hours watch time/day.&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Storage (Catalog):&lt;/b&gt; 10k titles × 3 res × 50GB = &lt;b&gt;~1.5 PB&lt;/b&gt; source.&lt;br&gt;• &lt;b&gt;Storage (CDN):&lt;/b&gt; Cached globally scales to &lt;b&gt;Exabytes&lt;/b&gt;.&lt;br&gt;• &lt;b&gt;Bandwidth:&lt;/b&gt; 200M users × 2 hrs × 3GB = &lt;b&gt;~111 Tbps&lt;/b&gt; peak.&lt;br&gt;• &lt;b&gt;QPS (Metadata):&lt;/b&gt; 200M DAU × 20 reqs / 86400 = &lt;b&gt;~46,000 QPS&lt;/b&gt;." vertex="1">
          <mxGeometry height="260" width="340" x="400" y="40" as="geometry" />
        </mxCell>
        <mxCell id="comp" parent="1" style="text;html=1;strokeColor=#999999;fillColor=#f9f9f9;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;rounded=1;shadow=1;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;3: Core Components Used&lt;/b&gt;&lt;hr&gt;• &lt;b&gt;Client:&lt;/b&gt; TVs, mobile, web browsers.&lt;br&gt;• &lt;b&gt;API Gateway (Zuul):&lt;/b&gt; SSL, routing, rate limiting.&lt;br&gt;• &lt;b&gt;Microservices:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;i&gt;User Svc:&lt;/i&gt; Auth &amp; billing.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;i&gt;Discovery Svc:&lt;/i&gt; Search &amp; recommendations.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;i&gt;Playback Svc:&lt;/i&gt; CDN routing &amp; licensing.&lt;br&gt;• &lt;b&gt;Databases:&lt;/b&gt; Cassandra (History), Elasticsearch (Search).&lt;br&gt;• &lt;b&gt;Open Connect:&lt;/b&gt; Netflix proprietary global CDN." vertex="1">
          <mxGeometry height="260" width="300" x="760" y="40" as="geometry" />
        </mxCell>
        <mxCell id="flow" parent="1" style="text;html=1;strokeColor=#999999;fillColor=#ffe6cc;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;rounded=1;shadow=1;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;4: Flow and Connections&lt;/b&gt;&lt;hr&gt;&lt;b&gt;1. Auth &amp; Browse:&lt;/b&gt; Client hits Gateway, routes to User/Discovery services to load UI.&lt;br&gt;&lt;b&gt;2. Metadata:&lt;/b&gt; Services pull data from Redis, Cassandra, and ElasticSearch.&lt;br&gt;&lt;b&gt;3. Play Request:&lt;/b&gt; Client clicks Play. Playback service verifies auth and finds 3 closest CDN edges.&lt;br&gt;&lt;b&gt;4. Streaming:&lt;/b&gt; Client connects &lt;u&gt;directly&lt;/u&gt; to Open Connect (CDN) bypassing AWS backend." vertex="1">
          <mxGeometry height="220" width="280" x="40" y="340" as="geometry" />
        </mxCell>
        <mxCell id="aws_box" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;startSize=20;align=left;spacingLeft=10;" value="AWS Region (Control Plane)" vertex="1">
          <mxGeometry height="380" width="460" x="360" y="440" as="geometry" />
        </mxCell>
        <mxCell id="gw" parent="aws_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;(Zuul / LB)" vertex="1">
          <mxGeometry height="60" width="140" x="160" y="40" as="geometry" />
        </mxCell>
