<mxfile host="app.diagrams.net" modified="2026-07-31T13:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device">
  <diagram id="url-shortener-design" name="URL Shortener System Design">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="URL SHORTENER — SYSTEM DESIGN" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="20" width="900" height="50" as="geometry"/>
        </mxCell>

        <!-- Requirements -->
        <mxCell id="req" value="FUNCTIONAL REQUIREMENTS&#xa;• Create short URL from long URL&#xa;• Redirect short URL to original URL&#xa;• Unique short codes&#xa;• Optional custom alias / expiry&#xa;• Track click statistics" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="350" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="nonreq" value="NON-FUNCTIONAL REQUIREMENTS&#xa;• High availability&#xa;• Low redirect latency&#xa;• Scalable to billions of URLs&#xa;• Fault tolerant&#xa;• Reliable storage + backups&#xa;• Fast reads using cache" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="100" width="350" height="190" as="geometry"/>
        </mxCell>

        <!-- Estimation -->
        <mxCell id="estimate" value="ASSUMPTIONS &amp; ESTIMATION&#xa;100M new URLs/month&#xa;Read : Write = 10 : 1&#xa;Retention = 5 years&#xa;Avg record ≈ 600 bytes&#xa;&#xa;Writes ≈ 39/sec average, ≈ 200/sec peak&#xa;Reads ≈ 390/sec average, ≈ 2,000/sec peak&#xa;5-year records ≈ 6 billion&#xa;Raw storage ≈ 3.6 TB" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="100" width="410" height="250" as="geometry"/>
        </mxCell>

        <!-- API -->
        <mxCell id="api" value="REST API ENDPOINTS&#xa;POST /api/v1/urls       Create short URL&#xa;GET /{shortCode}         302 Redirect&#xa;GET /api/v1/urls/{code}  URL information&#xa;GET /api/v1/urls/{code}/stats  Statistics&#xa;DELETE /api/v1/urls/{code}     Delete URL" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1210" y="100" width="500" height="190" as="geometry"/>
        </mxCell>

        <!-- DB -->
        <mxCell id="dbschema" value="DATABASE: urls&#xa;────────────────────────&#xa;id            BIGINT PK&#xa;short_code    VARCHAR(10) UNIQUE&#xa;original_url  TEXT&#xa;user_id       BIGINT&#xa;created_at    TIMESTAMP&#xa;expires_at    TIMESTAMP&#xa;click_count   BIGINT" style="shape=table;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=14;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1730" y="100" width="390" height="250" as="geometry"/>
        </mxCell>

        <!-- Main architecture -->
        <mxCell id="archtitle" value="HIGH-LEVEL ARCHITECTURE" style="text;html=1;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="390" width="900" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="client" value="Client&#xa;Web / Mobile" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="450" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="lb" value="Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="580" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="shortservice" value="URL Shortening Service&#xa;POST /api/v1/urls" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="720" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="redirectservice" value="Redirect Service&#xa;GET /{shortCode}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="720" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="idgen" value="ID Generator&#xa;+ Base62 Encoder&#xa;a-z A-Z 0-9&#xa;62⁷ ≈ 3.52 trillion codes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="880" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="redis" value="Redis Cache&#xa;short_code → original_url" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="880" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="database" value="URL Database&#xa;Persistent URL Mapping" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="1050" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="backup" value="Replication / Backup" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="1240" width="240" height="90" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="client" target="lb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Create URL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="lb" target="shortservice"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Redirect request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="lb" target="redirectservice"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Generate unique code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="shortservice" target="idgen"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Store mapping" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="shortservice" target="database"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Cache lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="redirectservice" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Cache miss → DB query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="redis" target="database"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Persist code + URL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="idgen" target="database"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Replicate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="database" target="backup"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Flow notes -->
        <mxCell id="flow" value="REDIRECT FLOW&#xa;1. User opens /a7Bx92&#xa;2. Redirect service checks Redis&#xa;3. Cache HIT → return URL immediately&#xa;4. Cache MISS → query database and cache result&#xa;5. Return HTTP 302 Location: original URL" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1460" y="1050" width="500" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="creation" value="CREATION FLOW&#xa;1. POST long URL&#xa;2. Generate unique ID&#xa;3. Base62 encode ID&#xa;4. Store short_code → original_url&#xa;5. Return https://short.ly/{code}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="90" y="1050" width="430" height="200" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>